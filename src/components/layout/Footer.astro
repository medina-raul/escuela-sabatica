---
import { siteConfig } from "@data/siteConfig";
const { brand, credits, links } = siteConfig.footer;
---

{links.length > 0 && (
  <div class="site-end">
    <div class="section-separator"></div>
    <section class="featured-section" aria-labelledby="featured-heading">
      <div class="section-heading">
        <h2 id="featured-heading">Enlaces destacados</h2>
      </div>
      <div class="featured-grid">
        {links.map(({ label, href, description, iconUrl }) => {
          const external = href.startsWith("https://");
          return (
            <a class="featured-card" href={href} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined}>
              {iconUrl && <span class="featured-icon"><img src={iconUrl} alt="" width="32" height="32" /></span>}
              <div>
                <strong>{label}</strong>
                {description && <span class="muted">{description}</span>}
              </div>
            </a>
          );
        })}
      </div>
    </section>
  </div>
)}

<div class="footer-sep"></div>

<footer class="site-footer">
  <span class="footer-brand">{brand}</span>
  {credits && <span class="footer-credits">{credits}</span>}
</footer>
