{
  "name": "escuela-sabatica",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "clean": "rm -rf dist/ .astro/",
    "test": "astro check",
    "resources:plan": "node scripts/run_python.mjs scripts/resource_pipeline.py --plan",
    "resources:sync": "node scripts/run_python.mjs scripts/resource_pipeline.py --apply",
    "resources:sync:offline": "node scripts/run_python.mjs scripts/resource_pipeline.py --apply --offline",
    "resources:restructure": "node scripts/run_python.mjs scripts/restructure_resources.py --apply",
    "resources:manual": "node scripts/run_python.mjs scripts/import_manual_resources.py --apply",
    "resources:status": "node scripts/run_python.mjs scripts/resource_status.py",
    "resources:update": "node scripts/run_python.mjs scripts/update_resources.py --apply",
    "resources:update:offline": "node scripts/run_python.mjs scripts/update_resources.py --offline",
    "resources:audit": "node scripts/run_python.mjs scripts/audit_resources.py --write-manifest",
    "resources:verify": "node scripts/run_python.mjs scripts/verify_deployment.py",
    "resources:teacher": "node scripts/run_python.mjs scripts/teacher_translation.py",
    "resources:test": "node scripts/run_python.mjs -m unittest discover -s scripts/tests -p test_*.py"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/react": "^5.0.7",
    "astro": "^6.4.6",
    "html2pdf.js": "^0.14.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3"
  }
}
